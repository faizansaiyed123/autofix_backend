# Normalise line endings so the repository behaves identically on Windows and
# Linux checkouts. Without this, `core.autocrlf=true` on a Windows machine hands
# out CRLF files, and two of those break the container build outright.
* text=auto

# Executed by a shell or as a container entrypoint. A CRLF line ending makes the
# shebang unrecognised, so these must stay LF even on a Windows checkout.
*.sh text eol=lf
Dockerfile text eol=lf
*.mako text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf

# Frontend sources and configuration.
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.txt text eol=lf

# Binary assets that must never be line-ending translated.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text eol=lf
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
*.gz binary
*.mp4 binary