# =============================================================================
# AutoFix — deployment configuration
# =============================================================================
#
# Copy to `.env` and edit. `docker compose` reads this file automatically; the
# backend reads it too, so the same values serve a container and a local run.
#
#     cp .env.example .env
#     python scripts/generate_secret.py >> .env     # or paste the line it prints
#
# `.env` is gitignored. Nothing in it should ever be committed.
# =============================================================================

# --- application -------------------------------------------------------------
APP_ENV=production
APP_DEBUG=false
# Overridden to 0.0.0.0 inside the container; this is for running the backend
# directly on the host, where loopback is the right default.
APP_HOST=127.0.0.1
APP_PORT=8000

# --- database ----------------------------------------------------------------
# Inside Docker, the host is the `postgres` service, not localhost. Compose
# rewrites this for you; the value below is only used when running the backend
# outside a container against a database on the same machine.
DATABASE_URL=postgresql+asyncpg://autofix:autofix@localhost:5432/autofix
POSTGRES_USER=autofix
POSTGRES_PASSWORD=autofix
POSTGRES_DB=autofix
POSTGRES_PORT=5432

# --- secrets -----------------------------------------------------------------
# REQUIRED, and the one setting here that must be different on every deployment.
# Signing keys are not passwords you can rotate by remembering them: anyone
# holding this value can mint a token for any user, including the owner, until it
# changes. `docker compose up` refuses to start without it rather than falling
# back to the development key published in the repository.
#
# Generate one with:  python scripts/generate_secret.py
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# --- CORS --------------------------------------------------------------------
# The browser's origin, as a JSON array. `*` is acceptable on a laptop and
# unacceptable on a deployed site: with a wildcard, any page on the internet can
# drive an authenticated session against this API.
ALLOWED_ORIGINS=["http://localhost:3000"]

# --- ports -------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- frontend build-time configuration ---------------------------------------
# These are inlined into the browser bundle when the image is built, so they are
# build arguments rather than runtime settings: changing one requires a rebuild.
# Must be an address a browser can open — not `http://backend:8000`, which
# resolves only inside the Docker network.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CURRENCY=USD
NEXT_PUBLIC_COMPANY_NAME=AutoFix Garage

# --- company -----------------------------------------------------------------
COMPANY_NAME=AutoFix Garage
COMPANY_CURRENCY=USD
COMPANY_TAX_RATE=0.0

# --- uploads -----------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10

# --- demo data ---------------------------------------------------------------
# 1 plants roles, permissions, the five demo logins and a shop's worth of work.
# Leave it at 0 for anything real.
AUTOFIX_SEED=0